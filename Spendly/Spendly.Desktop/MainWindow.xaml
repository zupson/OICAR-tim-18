<Window x:Class="Spendly.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Spendly.Desktop.Converters"
        Title="Spendly" Height="700" Width="1100"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">

    <Window.Resources>
        <conv:StringToInitialsConverter x:Key="StringToInitialsConverter"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="Padding"        Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Margin"         Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0d2240"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#112a52"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="20,22,20,18"
                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="7"
                                Background="{StaticResource AccentBlueBrush}" Margin="0,0,10,0">
                            <TextBlock Text="S" FontSize="16" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Spendly"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- User info + logout -->
                <Border DockPanel.Dock="Bottom" Padding="12,14"
                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                Background="{StaticResource AccentBlueBrush}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding LoggedInUser, Converter={StaticResource StringToInitialsConverter}}"
                                       FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding LoggedInUser}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="2" VerticalAlignment="Center"
                                Content="Odjava"
                                Command="{Binding LogoutCommand}"
                                Background="Transparent" Foreground="{StaticResource AccentRedBrush}"
                                BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1"
                                Padding="8,3" FontSize="11" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Nav items -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,8">

                        <!-- GLAVNO -->
                        <TextBlock Text="GLAVNO" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="20,0,0,4"/>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateDashboardCommand}" Tag="{Binding IsDashboardActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Nadzorna ploča" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateReportsCommand}" Tag="{Binding IsReportsActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEAFC;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Transakcije" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCategoriesCommand}" Tag="{Binding IsCategoriesActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Kategorije" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ANALITIKA -->
                        <TextBlock Text="ANALITIKA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="20,12,0,4"/>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateReportsChartCommand}" Tag="{Binding IsReportsChartActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEAFC;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Izvještaji" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- OBITELJ -->
                        <TextBlock Text="OBITELJ" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="20,12,0,4"/>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateFamilyCommand}" Tag="{Binding IsFamilyActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Obiteljska grupa" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateBudgetCommand}" Tag="{Binding IsBudgetActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A2;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Proračun" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- RAČUN -->
                        <TextBlock Text="RAČUN" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="20,12,0,4"/>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateObavijestCommand}" Tag="{Binding IsObavijestActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Obavijesti" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateSettingsCommand}" Tag="{Binding IsSettingsActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Postavke" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- Content area -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Background="{StaticResource BgDeepBrush}"/>

    </Grid>
</Window>
