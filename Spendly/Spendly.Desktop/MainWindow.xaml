<Window x:Class="Spendly.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spendly" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="Padding"        Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#112244"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="16,24,16,20"
                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Spendly"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBlueBrush}"/>
                </Border>

                <!-- User info -->
                <Border DockPanel.Dock="Bottom" Padding="16,12"
                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="Admin"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Border>

                <!-- Nav items -->
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <Button Content="  Nadzorna ploča" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateDashboardCommand}"/>
                    <Button Content="  Proračun"       Style="{StaticResource NavButton}"
                            Command="{Binding NavigateBudgetCommand}"/>
                    <Button Content="  Izvještaji"     Style="{StaticResource NavButton}"
                            Command="{Binding NavigateReportsCommand}"/>
                    <Button Content="  Obitelj"        Style="{StaticResource NavButton}"
                            Command="{Binding NavigateFamilyCommand}"/>
                    <Button Content="  Postavke"       Style="{StaticResource NavButton}"
                            Command="{Binding NavigateSettingsCommand}"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Content area -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Background="{StaticResource BgDeepBrush}"/>

    </Grid>
</Window>
