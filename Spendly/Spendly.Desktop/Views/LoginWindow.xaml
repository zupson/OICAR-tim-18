<Window x:Class="Spendly.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spendly" Height="480" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}">

    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="40"
            Padding="40">
        <StackPanel VerticalAlignment="Center">

            <!-- Logo -->
            <TextBlock Text="Spendly"
                       FontSize="32" FontWeight="Bold"
                       Foreground="{StaticResource AccentBlueBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Upravljanje obiteljskim financijama"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32"/>

            <!-- Username -->
            <TextBlock Text="Korisničko ime"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="UsernameBox"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                     Padding="10,8" FontSize="14"
                     Margin="0,0,0,16"/>

            <!-- Password -->
            <TextBlock Text="Lozinka"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox"
                         PasswordChanged="PasswordBox_PasswordChanged"
                         Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                         Padding="10,8" FontSize="14"
                         Margin="0,0,0,8"/>

            <!-- Error -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource AccentRedBrush}"
                       FontSize="12" Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- Login button -->
            <Button Content="Prijava"
                    Command="{Binding LoginCommand}"
                    Background="{StaticResource AccentBlueBrush}"
                    Foreground="White" FontSize="15" FontWeight="SemiBold"
                    BorderThickness="0" Padding="0,12"
                    Cursor="Hand"/>

        </StackPanel>
    </Border>
</Window>
