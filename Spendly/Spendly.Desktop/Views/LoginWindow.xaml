<Window x:Class="Spendly.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spendly" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Border Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="32"
                Padding="36">
            <StackPanel>

                <!-- Logo -->
                <TextBlock Text="Spendly"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource AccentBlueBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Upravljanje obiteljskim financijama"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Username -->
                <TextBlock Text="Korisničko ime"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                         Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                         Padding="10,8" FontSize="14"
                         Margin="0,0,0,16"/>

                <!-- Password -->
                <TextBlock Text="Lozinka"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                             Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                             Padding="10,8" FontSize="14"
                             Margin="0,0,0,16"/>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource AccentRedBrush}"
                           FontSize="12" Height="18" Margin="0,0,0,12"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Login button -->
                <Button Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Background="{StaticResource AccentBlueBrush}"
                        Foreground="White" FontSize="15" FontWeight="SemiBold"
                        BorderThickness="0" Padding="0,12"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Prijava"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="Učitavanje..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Register link -->
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="12">
                    <Run Text="Nemate račun? " Foreground="{StaticResource TextMutedBrush}"/>
                    <Hyperlink Click="Register_Click"
                               Foreground="{StaticResource AccentBlueBrush}"
                               TextDecorations="None">Registrirajte se</Hyperlink>
                </TextBlock>

                <!-- Dev hint -->
                <TextBlock Margin="0,10,0,0" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center">
                    <Run Text="testuser / Test1234"/>
                </TextBlock>

            </StackPanel>
        </Border>

        <!-- Loading overlay -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                Background="#cc0d1b2a" Panel.ZIndex="10" CornerRadius="12" Margin="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Učitavanje podataka..."
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Molimo pričekajte"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding DataLoadWarning}"
                           Visibility="{Binding DataLoadWarning, Converter={StaticResource StringToVisibilityConverter}}"
                           FontSize="12" Foreground="{StaticResource AccentAmberBrush}"
                           TextWrapping="Wrap" MaxWidth="240"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
