<Window x:Class="Spendly.Desktop.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spendly — Registracija" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="12"
                Margin="32" Padding="36">
            <StackPanel>

                <TextBlock Text="Spendly"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource AccentBlueBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Stvorite novi račun"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>


                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ime" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                 Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                 Padding="10,8" FontSize="13"/>
                        <TextBlock Text="{Binding FirstNameError}" Style="{StaticResource FieldError}"
                                   Visibility="{Binding FirstNameError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Prezime" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                 Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                 Padding="10,8" FontSize="13"/>
                        <TextBlock Text="{Binding LastNameError}" Style="{StaticResource FieldError}"
                                   Visibility="{Binding LastNameError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>


                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Email" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                             Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                             Padding="10,8" FontSize="13"/>
                    <TextBlock Text="{Binding EmailError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding EmailError, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>


                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Korisničko ime" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                             Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                             Padding="10,8" FontSize="13"/>
                    <TextBlock Text="{Binding UsernameError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding UsernameError, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>


                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Lozinka (min. 8 znakova)" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                 Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                 Padding="10,8" FontSize="13"/>
                    <TextBlock Text="{Binding PasswordError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding PasswordError, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>


                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Potvrda lozinke" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                 Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                 Padding="10,8" FontSize="13"/>
                    <TextBlock Text="{Binding ConfirmError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding ConfirmError, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>


                <TextBlock Text="{Binding GeneralError}"
                           Foreground="{StaticResource AccentRedBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding GeneralError, Converter={StaticResource StringToVisibilityConverter}}"/>


                <Button Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Background="{StaticResource AccentBlueBrush}"
                        Foreground="White" FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0" Padding="0,12"
                        Cursor="Hand" Margin="0,0,0,16">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Registriraj se"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="Učitavanje..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>


                <TextBlock HorizontalAlignment="Center" FontSize="12">
                    <Run Text="Već imate račun? " Foreground="{StaticResource TextMutedBrush}"/>
                    <Hyperlink Click="BackToLogin_Click"
                               Foreground="{StaticResource AccentBlueBrush}"
                               TextDecorations="None">Prijava</Hyperlink>
                </TextBlock>

            </StackPanel>
        </Border>


        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                Background="#cc0d1b2a" Panel.ZIndex="10" CornerRadius="12" Margin="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Učitavanje podataka..."
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Molimo pričekajte"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
