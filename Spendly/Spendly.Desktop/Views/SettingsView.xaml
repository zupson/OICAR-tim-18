<UserControl x:Class="Spendly.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock Text="Postavke"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,24"/>

            <!-- API section -->
            <StackPanel Margin="0,0,0,24">
                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                    <TextBlock Text="API" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8"/>
                </Border>
                <TextBlock Text="API Adresa" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}"
                         Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                         Padding="10,8" FontSize="13"/>
                <TextBlock Text="URL backend servera na koji se aplikacija spaja."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Currency section -->
            <StackPanel Margin="0,0,0,24">
                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                    <TextBlock Text="Valuta" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8"/>
                </Border>
                <TextBlock Text="Odabrana valuta" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Currencies}"
                          SelectedItem="{Binding SelectedCurrency}"
                          Width="120" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Alerts section -->
            <StackPanel Margin="0,0,0,24">
                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                    <TextBlock Text="Obavijesti" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8"/>
                </Border>
                <CheckBox IsChecked="{Binding BudgetWarningAlerts}"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                          Content="Upozorenje pri 80% iskorištenosti proračuna"
                          Margin="0,0,0,10"/>
                <CheckBox IsChecked="{Binding BudgetCriticalAlerts}"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                          Content="Kritično upozorenje pri 100% iskorištenosti proračuna"/>
            </StackPanel>

            <!-- Startup section -->
            <StackPanel Margin="0,0,0,32">
                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                    <TextBlock Text="Pokretanje" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8"/>
                </Border>
                <CheckBox IsChecked="{Binding StartMinimized}"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                          Content="Pokreni aplikaciju minimizirano"/>
            </StackPanel>

            <!-- Save row -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Spremi postavke"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource AccentBlueBrush}"
                        Foreground="White" BorderThickness="0"
                        Padding="20,10" FontSize="14" Cursor="Hand"
                        Margin="0,0,16,0"/>
                <TextBlock Text="{Binding SavedMessage, Mode=OneWay}"
                           FontSize="13" Foreground="{StaticResource AccentGreenBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding SavedMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
