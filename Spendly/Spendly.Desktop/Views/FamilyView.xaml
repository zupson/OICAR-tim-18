<UserControl x:Class="Spendly.Desktop.Views.FamilyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- Header row -->
            <Grid Margin="0,0,0,16">
                <TextBlock Text="Obitelj" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding ToggleAddFormCommand}"
                        Padding="16,8" FontSize="13" Cursor="Hand" BorderThickness="0" Foreground="White">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="+ Dodaj člana"/>
                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddFormOpen}" Value="True">
                                    <Setter Property="Content" Value="✕ Odustani"/>
                                    <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Add form -->
            <Border Visibility="{Binding IsAddFormOpen, Converter={StaticResource BoolToVisibility}}"
                    KeyDown="Form_KeyDown"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Novi član" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ime i prezime" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="MemberNameField"
                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                     Padding="10,8" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                     Padding="10,8" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Uloga" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding NewRole}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dodaj" Command="{Binding AddMemberCommand}"
                                Background="{StaticResource AccentGreenBrush}"
                                Foreground="White" BorderThickness="0"
                                Padding="20,8" FontSize="13" Cursor="Hand" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding AddError, Mode=OneWay}"
                                   Foreground="{StaticResource AccentRedBrush}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding AddError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Member cards -->
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="20" Margin="0,0,16,16">
                            <StackPanel>

                                <!-- Avatar + name + role + delete -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Margin="0,0,12,0"
                                            Background="{Binding AvatarColor, Converter={StaticResource StringToBrushConverter}}">
                                        <TextBlock Text="{Binding AvatarInitials, Mode=OneWay}"
                                                   FontSize="18" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1e3a5f"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Vlasnik">
                                                            <Setter Property="Background" Value="#1e3a7f"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Role, Mode=OneWay}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="Vlasnik">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <Button Content="✕"
                                                Visibility="{Binding IsNotConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RequestDeleteMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                                BorderThickness="0" FontSize="14" Cursor="Hand"/>
                                        <StackPanel Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="Obrisati?" FontSize="11"
                                                       Foreground="{StaticResource AccentRedBrush}"
                                                       HorizontalAlignment="Right" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Da"
                                                        Command="{Binding DataContext.ConfirmDeleteMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{StaticResource AccentRedBrush}" Foreground="White"
                                                        BorderThickness="0" Padding="8,3" FontSize="11" Cursor="Hand" Margin="0,0,4,0"/>
                                                <Button Content="Ne"
                                                        Command="{Binding DataContext.CancelDeleteMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                                        Padding="8,3" FontSize="11" Cursor="Hand"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Email -->
                                <TextBlock Text="{Binding Email, Mode=OneWay}"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,16"/>

                                <!-- Divider -->
                                <Border Height="1" Background="{StaticResource AppBorderBrush}" Margin="0,0,0,16"/>

                                <!-- Stats -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Prihodi" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentGreenBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource CurrencyConverter}">
                                                <Binding Path="TotalIncome" Mode="OneWay"/>
                                                <Binding Path="DataContext.ExchangeRate" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.CurrencySymbol" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Rashodi" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentRedBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource CurrencyConverter}">
                                                <Binding Path="TotalSpent" Mode="OneWay"/>
                                                <Binding Path="DataContext.ExchangeRate" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.CurrencySymbol" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Stanje" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding IsBalancePositive, Converter={StaticResource BoolToBrushConverter}}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource CurrencyConverter}">
                                                <Binding Path="Balance" Mode="OneWay"/>
                                                <Binding Path="DataContext.ExchangeRate" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.CurrencySymbol" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Visibility="{Binding HasNoMembers, Converter={StaticResource BoolToVisibility}}"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="32">
                <TextBlock Text="Nema članova obitelji. Kliknite '+ Dodaj člana' za početak."
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
