<UserControl x:Class="Spendly.Desktop.Views.FamilyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>


            <Grid Margin="0,0,0,16">
                <TextBlock Text="Obitelj" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleJoinFormCommand}"
                            Padding="16,8" FontSize="13" Cursor="Hand" BorderThickness="1" Margin="0,0,8,0"
                            Background="Transparent" Foreground="{StaticResource AccentBlueBrush}"
                            BorderBrush="{StaticResource AccentBlueBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Pridruži se grupi"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJoinFormOpen}" Value="True">
                                        <Setter Property="Content" Value="✕ Odustani"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ToggleAddFormCommand}"
                            Padding="16,8" FontSize="13" Cursor="Hand" BorderThickness="0" Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="+ Dodaj člana"/>
                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddFormOpen}" Value="True">
                                        <Setter Property="Content" Value="✕ Odustani"/>
                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>


            <Border Visibility="{Binding IsAddFormOpen, Converter={StaticResource BoolToVisibility}}"
                    KeyDown="Form_KeyDown"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Pozovi člana obitelji" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Korisnik mora imati Spendly račun. Pozivnica će biti poslana na njegov email."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"/>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Email adresa" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EmailField"
                                 Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                 Padding="10,8" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Pošalji pozivnicu" Command="{Binding AddMemberCommand}"
                                Background="{StaticResource AccentGreenBrush}"
                                Foreground="White" BorderThickness="0"
                                Padding="20,8" FontSize="13" Cursor="Hand" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding AddError, Mode=OneWay}"
                                   Foreground="{StaticResource AccentRedBrush}" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding AddError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>


            <Border Visibility="{Binding AddSuccess, Converter={StaticResource StringToVisibilityConverter}}"
                    Background="#0a3320" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,10" Margin="0,0,0,16">
                <TextBlock Text="{Binding AddSuccess}" Foreground="{StaticResource AccentGreenBrush}"
                           FontSize="13" TextWrapping="Wrap"/>
            </Border>


            <Border Visibility="{Binding IsJoinFormOpen, Converter={StaticResource BoolToVisibility}}"
                    KeyDown="JoinForm_KeyDown"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Pridruži se grupi" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Unesite token pozivnice koji ste dobili na email."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"/>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Token pozivnice" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TokenField"
                                 Text="{Binding JoinToken, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                 Padding="10,8" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Pridruži se" Command="{Binding JoinGroupCommand}"
                                Background="{StaticResource AccentGreenBrush}"
                                Foreground="White" BorderThickness="0"
                                Padding="20,8" FontSize="13" Cursor="Hand" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding JoinError, Mode=OneWay}"
                                   Foreground="{StaticResource AccentRedBrush}" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding JoinError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding JoinSuccess, Converter={StaticResource StringToVisibilityConverter}}"
                    Background="#0a3320" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,10" Margin="0,0,0,16">
                <TextBlock Text="{Binding JoinSuccess}" Foreground="{StaticResource AccentGreenBrush}"
                           FontSize="13" TextWrapping="Wrap"/>
            </Border>


            <Border Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Uloge u grupi" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Uloga" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="Opis" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Padding="8,2" Background="#1e3a7f"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="Vlasnik" FontSize="11" Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Kreator grupe. Dodaje i uklanja članove te upravlja grupom."/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Padding="8,2" Background="#3a2f0a"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="Admin" FontSize="11" Foreground="{StaticResource AccentAmberBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Upravlja zajedničkim troškovima i prihodima grupe."/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Padding="8,2" Background="#1e3a5f"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="Član" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Pregledava grupu i dodaje vlastite transakcije."/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding ActionError, Converter={StaticResource StringToVisibilityConverter}}"
                    Background="#3a0f0f" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,10" Margin="0,0,0,16">
                <TextBlock Text="{Binding ActionError}" Foreground="{StaticResource AccentRedBrush}"
                           FontSize="13" TextWrapping="Wrap"/>
            </Border>


            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20" Margin="0,0,16,16">
                            <StackPanel>


                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Margin="0,0,12,0"
                                            Background="{Binding AvatarColor, Converter={StaticResource StringToBrushConverter}}">
                                        <TextBlock Text="{Binding AvatarInitials, Mode=OneWay}"
                                                   FontSize="18" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1e3a5f"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Vlasnik">
                                                            <Setter Property="Background" Value="#1e3a7f"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Role, Mode=OneWay}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="Vlasnik">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Visibility="{Binding CanBeRemoved, Converter={StaticResource BoolToVisibility}}">
                                        <Button Content="✕"
                                                Visibility="{Binding IsNotConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RequestDeleteMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                                BorderThickness="0" FontSize="14" Cursor="Hand"/>
                                        <StackPanel Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="Obrisati?" FontSize="11"
                                                       Foreground="{StaticResource AccentRedBrush}"
                                                       HorizontalAlignment="Right" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Da"
                                                        Command="{Binding DataContext.ConfirmDeleteMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{StaticResource AccentRedBrush}" Foreground="White"
                                                        BorderThickness="0" Padding="8,3" FontSize="11" Cursor="Hand" Margin="0,0,4,0"/>
                                                <Button Content="Ne"
                                                        Command="{Binding DataContext.CancelDeleteMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                                        Padding="8,3" FontSize="11" Cursor="Hand"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>


                                <TextBlock Text="{Binding Email, Mode=OneWay}"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,16"/>


                                <Border Height="1" Background="{StaticResource AppBorderBrush}" Margin="0,0,0,16"/>


                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Prihodi" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentGreenBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource CurrencyConverter}">
                                                <Binding Path="TotalIncome" Mode="OneWay"/>
                                                <Binding Path="DataContext.ExchangeRate" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.CurrencySymbol" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Rashodi" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentRedBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource CurrencyConverter}">
                                                <Binding Path="TotalSpent" Mode="OneWay"/>
                                                <Binding Path="DataContext.ExchangeRate" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.CurrencySymbol" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Stanje" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding IsBalancePositive, Converter={StaticResource BoolToBrushConverter}}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource CurrencyConverter}">
                                                <Binding Path="Balance" Mode="OneWay"/>
                                                <Binding Path="DataContext.ExchangeRate" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.CurrencySymbol" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Visibility="{Binding HasNoMembers, Converter={StaticResource BoolToVisibility}}"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="32">
                <TextBlock Text="Nema članova obitelji. Kliknite '+ Dodaj člana' za početak."
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
