<UserControl x:Class="Spendly.Desktop.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Spendly.Desktop.ViewModels"
             Background="{StaticResource BgDeepBrush}">

    <UserControl.Resources>
        <Style x:Key="CatCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16"/>
            <Setter Property="Width"           Value="210"/>
            <Setter Property="Margin"          Value="0,0,12,12"/>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground"  Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
        </Style>
        <Style x:Key="TypeTabBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#1e3a5f"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <TextBlock Text="Kategorije" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <Border Background="#3a0f0f" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding DeleteError, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding DeleteError}" FontSize="12"
                               Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap"/>
                </Border>

                <!-- Expense categories -->
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Troškovi" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Content="+ Dodaj kategoriju"
                            Command="{Binding OpenAddCommand}" CommandParameter="expense"
                            Background="{StaticResource AccentBlueBrush}" Foreground="White"
                            BorderThickness="0" Padding="14,7" FontSize="12" Cursor="Hand"/>
                </Grid>
                <TextBlock Text="Nema kategorija troškova." FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"
                           Visibility="{Binding HasNoExpenseCategories, Converter={StaticResource BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding ExpenseCategories}" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CatCard}">
                                <StackPanel>
                                    <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,8"
                                            Background="{Binding Color, Converter={StaticResource StringToBrushConverter}}">
                                        <TextBlock Text="💸" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} transakcija · {1}">
                                                <Binding Path="Count"/>
                                                <Binding Path="TypeLabel"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Grid Height="4" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Pct,      Converter={StaticResource IntToGridLength}}"/>
                                            <ColumnDefinition Width="{Binding Remaining, Converter={StaticResource IntToGridLength}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{Binding Color, Converter={StaticResource StringToBrushConverter}}" CornerRadius="2"/>
                                        <Border Grid.Column="1" Background="#1e3a5f" CornerRadius="2"/>
                                    </Grid>
                                    <TextBlock FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource AccentRedBrush}" Margin="0,0,0,12">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource CurrencyConverter}">
                                                <Binding Path="Total"/>
                                                <Binding Path="Rate"/>
                                                <Binding Path="Symbol"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Uredi" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Obriši" Style="{StaticResource DangerBtn}"
                                                Visibility="{Binding IsNotConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RequestDeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Obrisati?" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,6,0"/>
                                            <Button Content="Da"
                                                    Background="{StaticResource AccentRedBrush}" Foreground="White"
                                                    BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Ne" Style="{StaticResource GhostBtn}"
                                                    Command="{Binding DataContext.CancelDeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Revenue categories -->
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Prihodi" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Content="+ Dodaj kategoriju"
                            Command="{Binding OpenAddCommand}" CommandParameter="revenue"
                            Background="{StaticResource AccentBlueBrush}" Foreground="White"
                            BorderThickness="0" Padding="14,7" FontSize="12" Cursor="Hand"/>
                </Grid>
                <TextBlock Text="Nema kategorija prihoda." FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"
                           Visibility="{Binding HasNoRevenueCategories, Converter={StaticResource BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding RevenueCategories}" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CatCard}">
                                <StackPanel>
                                    <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,8"
                                            Background="{Binding Color, Converter={StaticResource StringToBrushConverter}}">
                                        <TextBlock Text="💰" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} transakcija · {1}">
                                                <Binding Path="Count"/>
                                                <Binding Path="TypeLabel"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Grid Height="4" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Pct,      Converter={StaticResource IntToGridLength}}"/>
                                            <ColumnDefinition Width="{Binding Remaining, Converter={StaticResource IntToGridLength}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{Binding Color, Converter={StaticResource StringToBrushConverter}}" CornerRadius="2"/>
                                        <Border Grid.Column="1" Background="#1e3a5f" CornerRadius="2"/>
                                    </Grid>
                                    <TextBlock FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,12">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource CurrencyConverter}">
                                                <Binding Path="Total"/>
                                                <Binding Path="Rate"/>
                                                <Binding Path="Symbol"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Uredi" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Obriši" Style="{StaticResource DangerBtn}"
                                                Visibility="{Binding IsNotConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RequestDeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Obrisati?" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,6,0"/>
                                            <Button Content="Da"
                                                    Background="{StaticResource AccentRedBrush}" Foreground="White"
                                                    BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Ne" Style="{StaticResource GhostBtn}"
                                                    Command="{Binding DataContext.CancelDeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Modal overlay -->
        <Border Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVisibility}}"
                Background="#b0000000" Panel.ZIndex="10">
            <Border Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="24" Width="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Modal header -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Nova kategorija"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="Uredi kategoriju"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding CloseModalCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextMutedBrush}" FontSize="14" Cursor="Hand"/>
                    </Grid>

                    <!-- Type toggle (only shown for new categories) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16"
                                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibility}}">
                        <Button Content="Trošak" Style="{StaticResource TypeTabBtn}" Margin="0,0,8,0"
                                Tag="{Binding IsRevenue, Converter={StaticResource InverseBoolConverter}}"
                                Command="{Binding SetTypeCommand}" CommandParameter="expense"/>
                        <Button Content="Prihod" Style="{StaticResource TypeTabBtn}"
                                Tag="{Binding IsRevenue}"
                                Command="{Binding SetTypeCommand}" CommandParameter="revenue"/>
                    </StackPanel>

                    <TextBlock Text="Naziv kategorije" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ModalName, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1a3a5c" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                             Padding="10,8" FontSize="13" Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding ModalError}" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentRedBrush}" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding ModalError, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <Button Command="{Binding SaveCommand}" Cursor="Hand"
                            Background="{StaticResource AccentBlueBrush}" Foreground="White"
                            BorderThickness="0" Padding="0,10" FontSize="13">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Spremi"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="Content" Value="Sprema..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
