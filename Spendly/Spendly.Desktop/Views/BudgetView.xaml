<UserControl x:Class="Spendly.Desktop.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <TextBlock Text="Proračun"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,24"/>

            <ItemsControl ItemsSource="{Binding Budgets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="20" Margin="0,0,0,12">
                            <StackPanel>

                                <!-- Name row -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding AlertLevel, Converter={StaticResource AlertLevelToBrushConverter}}">
                                        <Run Text="{Binding ProgressPercent, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        <Run Text="%"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Spent / Limit -->
                                <TextBlock FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,10">
                                    <Run Text="{Binding Spent, StringFormat={}{0:N2} €, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding Limit, StringFormat={}{0:N2} €, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Progress bar -->
                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Maximum="100" Height="8"
                                             Foreground="{Binding AlertLevel, Converter={StaticResource AlertLevelToBrushConverter}}"
                                             BorderThickness="0" Margin="0,0,0,10">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border x:Name="PART_Track"
                                                    Background="#1e3a5f"
                                                    CornerRadius="4" ClipToBounds="True">
                                                <Border x:Name="PART_Indicator"
                                                        Background="{TemplateBinding Foreground}"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="4"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>

                                <!-- Remaining / Over budget -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding RemainingLabel, Mode=OneWay}"/>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                               Foreground="{Binding AlertLevel, Converter={StaticResource AlertLevelToBrushConverter}}"
                                               Text="{Binding RemainingAbsolute, StringFormat={}{0:N2} €, Mode=OneWay}"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
