<Application x:Class="Spendly.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Spendly.Desktop.ViewModels"
             xmlns:views="clr-namespace:Spendly.Desktop.Views"
             xmlns:conv="clr-namespace:Spendly.Desktop.Converters">
    <Application.Resources>

        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:CurrencyConverter x:Key="CurrencyConverter"/>
        <conv:AlertLevelToBrushConverter x:Key="AlertLevelToBrushConverter"/>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <conv:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Color palette -->
        <SolidColorBrush x:Key="BgDeepBrush"    Color="#0D1B2A"/>
        <SolidColorBrush x:Key="BgCardBrush"     Color="#0F2744"/>
        <SolidColorBrush x:Key="BgSidebarBrush"  Color="#0a1628"/>
        <SolidColorBrush x:Key="AppBorderBrush"  Color="#1e3a5f"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="AccentRedBrush"  Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94a3b8"/>
        <SolidColorBrush x:Key="TextMutedBrush"    Color="#64748B"/>

        <!-- ViewModel → View wiring -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetViewModel}">
            <views:BudgetView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FamilyViewModel}">
            <views:FamilyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

    </Application.Resources>
</Application>
